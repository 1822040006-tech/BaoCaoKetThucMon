rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Chỉ các UID quản trị được cấp trực tiếp mới có quyền quản trị Firestore.
    function isAdmin() {
      return signedIn()
        && (request.auth.uid == 'ZfYnXtJ6P4bcZsqhixBmDRvC3xC2'
          || request.auth.uid == 'AqwFOXP7YJVN0hhV8xL7l6hEBgx2')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Đăng ký công khai chỉ tạo hồ sơ sinh viên cho chính UID vừa đăng ký.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'status', 'studentCode',
          'phoneNumber', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'role', 'status', 'studentCode',
          'phoneNumber', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.matches('^[0-9]{6}$')
        && request.resource.data.phoneNumber is string
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.resource.data.studentCode + '@university.com'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
